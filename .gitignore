# Generated reports (script output, not source)
*_comparison.html
*_comparison.md
*_missing.csv
*_overrides.json
*_shopping_list.csv

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Flask app runtime data -- your ManaBox collection + saved project state,
# not source and not meant to be shared/committed
data/

# Belt-and-suspenders: your Anthropic API key, already covered by the
# bare data/ rule above -- called out explicitly since this is the one
# file where a slip would actually leak a live credential
data/ai_config.json

# OS / editor cruft
.DS_Store

# Local harness config (not meant to be shared)
.claude/
